# 复制为 scripts/dev-secrets.ps1 后填入真实值（该文件已 gitignore，勿提交）
# 使用：在仓库根目录执行  . .\scripts\load-dev-env.ps1
# 本文件仅作变量名示例，不要写入真实 Key

# --- Java 后端 ---
$env:PII_CRYPTO_SECRET = "请填写至少32字符随机串"
$env:JWT_SECRET = "请填写至少32字符随机串"
$env:ALIYUN_ACCESS_KEY_ID = ""
$env:ALIYUN_ACCESS_KEY_SECRET = ""
$env:MAIL_USERNAME = "noreply@example.com"
$env:MAIL_PASSWORD = ""
$env:OSS_BUCKET_NAME = "your-forum-oss-bucket"
$env:OSS_URL_PREFIX = "https://your-forum-oss-bucket.oss-cn-shenzhen.aliyuncs.com/"

# --- AI 服务（本地 python main.py）---
$env:DASHSCOPE_API_KEY = ""
$env:DEEPSEEK_API_KEY = ""
$env:HUANAPI_IMAGE_KEY = ""
$env:HUANAPI_GEMINI_KEY = ""

# --- 可选：Java <-> AI 内网校验 ---
# $env:FORUM_MASCOT_INTERNAL_KEY = ""
# $env:FORUM_AI_INTERNAL_KEY = ""
