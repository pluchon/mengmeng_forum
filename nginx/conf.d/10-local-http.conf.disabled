# 本地开发用；生产 nuonuoya.cn 请保持禁用，使用 20-prod-https.conf
# 启用：重命名为 10-local-http.conf

server {
    listen 80 default_server;
    server_name localhost 127.0.0.1 _;

    client_max_body_size 30m;

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    set $forum_spa_root /usr/share/nginx/user;
    include /etc/nginx/conf.d/snippets/forum-api.inc;
    include /etc/nginx/conf.d/snippets/forum-spa.inc;
}

server {
    listen 80;
    server_name admin.localhost;

    client_max_body_size 30m;

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    set $forum_spa_root /usr/share/nginx/admin;
    include /etc/nginx/conf.d/snippets/forum-api.inc;
    include /etc/nginx/conf.d/snippets/forum-spa.inc;
}
