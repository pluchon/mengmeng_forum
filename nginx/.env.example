# Copy to .env on the server and fill in real values (do not commit .env)
# Production domains: www.nuonuoya.cn / admin.nuonuoya.cn

NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

FORUM_BACKEND_IMAGE=forum-backend:latest
FORUM_AI_IMAGE=forum-ai-server:latest
SPRING_PROFILES_ACTIVE=prod

MYSQL_ROOT_PASSWORD=CHANGE_ME_mysql_root
MYSQL_USER=forum_user
MYSQL_PASSWORD=CHANGE_ME_mysql_password
MYSQL_HOST_PORT=33061

REDIS_PASSWORD=CHANGE_ME_redis
REDIS_HOST_PORT=63790

RABBITMQ_USER=forum
RABBITMQ_PASSWORD=CHANGE_ME_rabbitmq
RABBITMQ_VHOST=forum-demo
RABBITMQ_AMQP_PORT=56720
RABBITMQ_MGMT_PORT=15672

POSTGRES_USER=langgraph
POSTGRES_PASSWORD=CHANGE_ME_postgres
POSTGRES_DB=langgraph_db
POSTGRES_HOST_PORT=54320

PII_CRYPTO_SECRET=CHANGE_ME_pii_secret_min_32_chars
JWT_SECRET=CHANGE_ME_jwt_secret_min_32_chars_hs256

JAVA_TOOL_OPTIONS="-Xms256m -Xmx512m"

FORUM_MASCOT_INTERNAL_KEY=CHANGE_ME_mascot_internal_key
FORUM_AI_INTERNAL_KEY=CHANGE_ME_ai_internal_key

ALIYUN_ACCESS_KEY_ID=CHANGE_ME_aliyun_access_key_id
ALIYUN_ACCESS_KEY_SECRET=CHANGE_ME_aliyun_access_key_secret
OSS_BUCKET_NAME=your-oss-bucket
OSS_URL_PREFIX=https://your-bucket.oss-cn-hangzhou.aliyuncs.com/
OSS_ROOT_PREFIX=

MAIL_USERNAME=your@example.com
MAIL_PASSWORD=CHANGE_ME_mail_app_password

DASHSCOPE_API_KEY=sk-CHANGE_ME_dashscope
# 须为 https://platform.deepseek.com 申请的密钥，勿与 DASHSCOPE_API_KEY 混用
DEEPSEEK_API_KEY=sk-CHANGE_ME_deepseek
HUANAPI_GEMINI_KEY=sk-CHANGE_ME_huanapi_gemini
HUANAPI_IMAGE_KEY=sk-CHANGE_ME_huanapi_image
HUANAPI_CLAUDE_KEY=sk-CHANGE_ME_huanapi_claude
TAVILY_API_KEY=tvly-CHANGE_ME_tavily
