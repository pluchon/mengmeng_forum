# Copy to .env on the server and fill in real values (do not commit .env)
# Production domains: www.nuonuoya.cn

NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

FORUM_BACKEND_IMAGE=forum-backend:latest
FORUM_AI_IMAGE=forum-ai-server:latest
SPRING_PROFILES_ACTIVE=prod

MYSQL_ROOT_PASSWORD=CHANGE_ME_mysql_root
MYSQL_USER=forum_user
MYSQL_PASSWORD=CHANGE_ME_mysql_password
MYSQL_HOST_PORT=33306

FORUM_AUTH_DB_USERNAME=forum_auth
FORUM_AUTH_DB_PASSWORD=CHANGE_ME_forum_auth_db
FORUM_CONTENT_DB_USERNAME=forum_content
FORUM_CONTENT_DB_PASSWORD=CHANGE_ME_forum_content_db
FORUM_IM_DB_USERNAME=forum_im
FORUM_IM_DB_PASSWORD=CHANGE_ME_forum_im_db
FORUM_GAME_DB_USERNAME=forum_game
FORUM_GAME_DB_PASSWORD=CHANGE_ME_forum_game_db
FORUM_ECONOMY_DB_USERNAME=forum_economy
FORUM_ECONOMY_DB_PASSWORD=CHANGE_ME_forum_economy_db
FORUM_AI_DB_USERNAME=forum_ai
FORUM_AI_DB_PASSWORD=CHANGE_ME_forum_ai_db

# 单机部署使用 Compose 内网 Nacos；如使用独立 Nacos，可填写内网地址。
NACOS_ADDR=nacos:8848
NACOS_NAMESPACE=
# Nacos 3.x 容器的内部启动值；首次运行 up.sh 时自动生成，勿手工复用示例值。
NACOS_AUTH_TOKEN=
NACOS_AUTH_IDENTITY_KEY=
NACOS_AUTH_IDENTITY_VALUE=

REDIS_PASSWORD=CHANGE_ME_redis
REDIS_HOST_PORT=63790

RABBITMQ_USER=forum
RABBITMQ_PASSWORD=CHANGE_ME_rabbitmq
RABBITMQ_VHOST=forum-demo
RABBITMQ_AMQP_PORT=56720
RABBITMQ_MGMT_PORT=15672

POSTGRES_USER=langgraph
POSTGRES_PASSWORD=CHANGE_ME_postgres
POSTGRES_DB=langgraph_db
POSTGRES_HOST_PORT=54320

PII_CRYPTO_SECRET=CHANGE_ME_pii_secret_min_32_chars
JWT_SECRET=CHANGE_ME_jwt_secret_min_32_chars_hs256

JAVA_TOOL_OPTIONS="-Xms256m -Xmx512m"

# 留空则在 ~/package 同级创建 ../logs；发布包替换不会覆盖该目录。
# 目录约定：java-backend/  python-backend/  ffmpeg/  nginx/
FORUM_LOG_DIR=../logs
# 可选：覆盖 Java 容器内日志文件路径（默认 /app/logs/forum-backend/forum-backend.log）
# LOG_FILE=/app/logs/forum-backend/forum-backend.log

FORUM_MASCOT_INTERNAL_KEY=CHANGE_ME_mascot_internal_key
FORUM_AI_INTERNAL_KEY=CHANGE_ME_ai_internal_key
FORUM_FFMPEG_INTERNAL_KEY=CHANGE_ME_ffmpeg_internal_key
FORUM_VOICE_STUN_URLS=stun:turn.nuonuoya.cn:3478
FORUM_VOICE_TURN_URLS=turn:turn.nuonuoya.cn:3478?transport=udp,turn:turn.nuonuoya.cn:3478?transport=tcp
FORUM_VOICE_TURN_USERNAME=forum_voice
FORUM_VOICE_TURN_CREDENTIAL=CHANGE_ME_turn_password
FORUM_VOICE_TURN_SECRET=
FORUM_VOICE_TURN_TTL_SECONDS=3600
AI_REQUIRE_INTERNAL_KEY=1
FFMPEG_REQUIRE_INTERNAL_KEY=1

ALIYUN_ACCESS_KEY_ID=CHANGE_ME_aliyun_access_key_id
ALIYUN_ACCESS_KEY_SECRET=CHANGE_ME_aliyun_access_key_secret
# 本地开发与服务器分别使用不同桶。不要再设置旧的 OSS_BUCKET_NAME / OSS_URL_PREFIX。
OSS_LOCAL_ENDPOINT=https://oss-cn-shenzhen.aliyuncs.com
OSS_LOCAL_BUCKET_NAME=item-for-picture-with-zhanglihong-local-develop
OSS_LOCAL_URL_PREFIX=https://item-for-picture-with-zhanglihong-local-develop.oss-cn-shenzhen.aliyuncs.com/
OSS_LOCAL_ROOT_PREFIX=
OSS_SERVER_ENDPOINT=https://oss-cn-shenzhen.aliyuncs.com
OSS_SERVER_BUCKET_NAME=item-for-picture-with-zhanglihong
OSS_SERVER_URL_PREFIX=https://item-for-picture-with-zhanglihong.oss-cn-shenzhen.aliyuncs.com/
OSS_SERVER_ROOT_PREFIX=
# 如两套桶使用不同 RAM 凭据，在受控环境中设置以下变量；否则沿用 ALIYUN_ACCESS_KEY_ID/SECRET。
# OSS_LOCAL_ACCESS_KEY_ID=
# OSS_LOCAL_ACCESS_KEY_SECRET=
# OSS_SERVER_ACCESS_KEY_ID=
# OSS_SERVER_ACCESS_KEY_SECRET=

MAIL_USERNAME=your@example.com
MAIL_PASSWORD=CHANGE_ME_mail_app_password

DASHSCOPE_API_KEY=sk-CHANGE_ME_dashscope
HUANAPI_IMAGE_KEY=sk-CHANGE_ME_huanapi_image
TAVILY_API_KEY=tvly-CHANGE_ME_tavily
