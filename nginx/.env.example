# 复制为 .env 后按需修改：cp .env.example .env
# 生产域名：www.nuonuoya.cn / admin.nuonuoya.cn

NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

FORUM_BACKEND_IMAGE=forum-backend:latest
FORUM_AI_IMAGE=forum-ai-server:latest
SPRING_PROFILES_ACTIVE=prod

MYSQL_ROOT_PASSWORD=123456789
MYSQL_USER=forum_user
MYSQL_PASSWORD=123456789
MYSQL_HOST_PORT=33061

REDIS_PASSWORD=123456
REDIS_HOST_PORT=63790

RABBITMQ_USER=nuonuo
RABBITMQ_PASSWORD=123456
RABBITMQ_VHOST=forum-demo
RABBITMQ_AMQP_PORT=56720
RABBITMQ_MGMT_PORT=15672

POSTGRES_USER=langgraph
POSTGRES_PASSWORD=123456
POSTGRES_DB=langgraph_db
POSTGRES_HOST_PORT=54320

# 后端必填（prod 无默认值，未设置会导致 forum-backend 启动失败、CPU 飙高）
# 生成示例：openssl rand -base64 32
PII_CRYPTO_SECRET=CHANGE_ME_pii_secret_min_32_chars
JWT_SECRET=CHANGE_ME_jwt_secret_min_32_chars_hs256

# 小内存服务器 JVM（可选）
JAVA_TOOL_OPTIONS=-Xms256m -Xmx512m

# AI 服务（勿提交真实 Key；Docker 与本地开发见 WINDOWS-ENV.md）
DASHSCOPE_API_KEY=
DEEPSEEK_API_KEY=
HUANAPI_IMAGE_KEY=
HUANAPI_GEMINI_KEY=
